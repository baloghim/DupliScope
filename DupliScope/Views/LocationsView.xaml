<UserControl x:Class="DupliScope.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="HELYEK KIVÁLASZTÁSA" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{Binding SelectedModeTitle}" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding LocationDescription}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" />
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image Source="/DupliScope;component/Assets/Icons/Oxylite/folder.png" Width="36" Height="36" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding FirstLocationTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Label Content="_Elérési út" Target="{Binding ElementName=FirstPath}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FirstPath" Style="{StaticResource PathBox}" Text="{Binding FirstLocation, Mode=OneWay, TargetNullValue='Még nincs kiválasztott hely'}"
                             AutomationProperties.Name="Első hely elérési útja" />
                    <Button Grid.Column="1" Command="{Binding BrowseFirstCommand}" Margin="12,0,0,0" AutomationProperties.Name="Első hely kiválasztása">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/DupliScope;component/Assets/Icons/Oxylite/folder.png" Width="22" Height="22" Margin="0,0,8,0" />
                            <AccessText Text="_Tallózás…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Visibility="{Binding IsTwoLocations, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image Source="/DupliScope;component/Assets/Icons/Oxylite/folder.png" Width="36" Height="36" Margin="0,0,12,0" />
                    <TextBlock Text="B hely" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Label Content="Elérési út" Target="{Binding ElementName=SecondPath}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SecondPath" Style="{StaticResource PathBox}" Text="{Binding SecondLocation, Mode=OneWay, TargetNullValue='Még nincs kiválasztott hely'}"
                             AutomationProperties.Name="Második hely elérési útja" />
                    <Button Grid.Column="1" Command="{Binding BrowseSecondCommand}" Margin="12,0,0,0" AutomationProperties.Name="Második hely kiválasztása">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/DupliScope;component/Assets/Icons/Oxylite/folder.png" Width="22" Height="22" Margin="0,0,8,0" />
                            <AccessText Text="_Másik hely…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
        <Border Background="#FFF1F0" BorderBrush="#E8AAA5" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,18,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#8D2820" AutomationProperties.LiveSetting="Assertive" />
        </Border>
        <Border Background="#EAF2FD" CornerRadius="8" Padding="20" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="A keresés hamarosan érkezik" FontWeight="SemiBold" Foreground="#24538D" />
                <TextBlock Text="Ebben a verzióban a keresési helyeket és a beállításokat készítheted elő. Fájlkeresés és fájlmódosítás még nem történik."
                           Foreground="#365A85" Margin="0,7,0,0" LineHeight="22" />
                <TextBlock Text="A Vissza gomb megőrzi a kiválasztott módot, helyeket és beállításokat." Foreground="#365A85" Margin="0,8,0,0" FontSize="12" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
