<UserControl x:Class="DupliScope.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Válassz keresési módot" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Hol szeretnéd megkeresni az ismétlődő fájlokat?" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" />
        <Grid KeyboardNavigation.TabNavigation="Once">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <RadioButton Style="{StaticResource ModeCard}" GroupName="SearchMode" IsChecked="{Binding IsSingleLocation, Mode=TwoWay}"
                         AutomationProperties.Name="Keresés egy helyen belül" AutomationProperties.HelpText="Egy meghajtón vagy mappában keresi a duplikátumokat.">
                <StackPanel MinHeight="216" VerticalAlignment="Center">
                    <Image Source="/DupliScope;component/Assets/Icons/Oxylite/folder.png" Width="104" Height="104" Margin="0,0,0,18" />
                    <TextBlock Text="Keresés egy helyen belül" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Egy meghajtón vagy mappában keresi a duplikátumokat." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="22" />
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" Style="{StaticResource ModeCard}" GroupName="SearchMode" IsChecked="{Binding IsTwoLocations, Mode=TwoWay}"
                         AutomationProperties.Name="Keresés két hely között" AutomationProperties.HelpText="Két kijelölt meghajtón vagy könyvtárban keresi a duplikátumokat.">
                <StackPanel MinHeight="216" VerticalAlignment="Center">
                    <Image Source="/DupliScope;component/Assets/Icons/Oxylite/kr_comparedirs.png" Width="104" Height="104" Margin="0,0,0,18" />
                    <TextBlock Text="Keresés két hely között" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Két kijelölt meghajtón vagy könyvtárban keresi a duplikátumokat." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="22" />
                </StackPanel>
            </RadioButton>
        </Grid>
        <Border Style="{StaticResource Panel}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="Keresési beállítások" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox IsChecked="{Binding IncludeSubfolders}" Content="Almappák vizsgálata" />
                <CheckBox IsChecked="{Binding UseFileTypeFilter}" Content="Fájltípus szűrés" />
                <CheckBox IsChecked="{Binding UseExcludedFolders}" Content="Kizárt mappák" />
                <TextBlock Text="A fájltípusok és a kizárt mappák részletes megadása egy későbbi verzióban lesz elérhető."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
